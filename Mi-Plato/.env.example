# Clave de la API de Gemini (https://aistudio.google.com/apikey).
# En Vercel se carga en Settings > Environment Variables.
# Para desarrollo local: copiá este archivo como .env.local y pegá tu clave.
GEMINI_API_KEY=

# Opcional: modelo a usar (por defecto gemini-flash-latest)
# GEMINI_MODEL=gemini-3.6-flash
