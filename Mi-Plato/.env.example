# Clave de la API de Gemini (https://aistudio.google.com/apikey).
# En Vercel se carga en Settings > Environment Variables.
# Para desarrollo local: copiá este archivo como .env.local y completalo.
GEMINI_API_KEY=

# Supabase (Project Settings > API Keys): URL del proyecto y clave PÚBLICA (publishable / anon).
# Nunca pongas acá la clave secreta (service_role / secret).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Opcional: forzar un modelo (si no, prueba gemini-3.6-flash, 3.5-flash, 3.5-flash-lite y flash-latest en ese orden)
# GEMINI_MODEL=gemini-3.6-flash

# Sugerencias por mail (https://resend.com > API Keys). Te llegan a MAIL_SUGERENCIAS
# (con el remitente de prueba de Resend tiene que ser el mismo mail de tu cuenta de Resend).
RESEND_API_KEY=
MAIL_SUGERENCIAS=
# Opcional, si verificaste un dominio en Resend:
# MAIL_REMITENTE=Mi Plato <hola@tudominio.com>
