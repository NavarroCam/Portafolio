# Clave de la API de Gemini (https://aistudio.google.com/apikey).
# En Vercel se carga en Settings > Environment Variables.
# Para desarrollo local: copiá este archivo como .env.local y completalo.
GEMINI_API_KEY=

# Supabase (Project Settings > API Keys): URL del proyecto y clave PÚBLICA (publishable / anon).
# Nunca pongas acá la clave secreta (service_role / secret).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Opcional: modelo a usar (por defecto gemini-flash-latest)
# GEMINI_MODEL=gemini-3.6-flash
