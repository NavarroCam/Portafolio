# Copiá este archivo como ".env" y completá tus datos.

# Cómo te va a llamar Jarvis
USER_NAME=Cam

# --- Cerebro: Ollama (modelo local y gratis) ---
OLLAMA_URL=http://localhost:11434
# gemma3:4b  -> recomendado: responde directo, sin "pensar en voz alta", buen español
# gemma3:1b  -> más liviano y rápido, para PCs con poca RAM (menos inteligente)
# qwen3:4b   -> razona antes de responder: más lento
OLLAMA_MODEL=gemma3:4b
# Creatividad del modelo (0 a 1). Más bajo = inventa menos
TEMPERATURE=0.3

# --- Oídos: Whisper (local y gratis) ---
# true = presionás Enter y le hablás por el micrófono
VOICE_INPUT=true
# tiny / base / small / medium  (más grande = entiende mejor, pero más lento)
# Si te entiende mal seguido, probá con medium
WHISPER_MODEL=small

# --- Voz: edge-tts (gratis, necesita internet) ---
# true = Jarvis responde hablando
VOICE_OUTPUT=true
# Otras voces: es-AR-ElenaNeural, es-ES-AlvaroNeural, es-MX-JorgeNeural
TTS_VOICE=es-AR-TomasNeural
# Velocidad de la voz: "+10%" más rápido, "-10%" más lento
TTS_RATE=+0%

# --- Herramientas ---
# Ciudad para el clima cuando no nombrás ninguna
CITY=Buenos Aires
# Dirección secreta en formato iCal de tu Google Calendar (solo lectura).
# Google Calendar > Configuración > tu calendario > "Dirección secreta en formato iCal"
# ¡Es privada! No la compartas: cualquiera con este link puede ver tu agenda.
CALENDAR_ICAL_URL=
